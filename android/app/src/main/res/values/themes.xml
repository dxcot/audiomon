<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One dark world: the record is black vinyl, so the screen is too. -->
    <style name="Theme.Audiorast" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/vinyl</item>
        <item name="android:colorBackground">@color/vinyl</item>
        <item name="android:textColorPrimary">@color/cream</item>
        <item name="android:textColorSecondary">@color/cream_muted</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Audiorast.Button" parent="android:Widget.DeviceDefault.Button.Borderless">
        <!-- One line always: long labels or large font sizes shrink instead of wrapping,
             so the two buttons of a row stay the same height and aligned. -->
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">12sp</item>
        <item name="android:autoSizeMaxTextSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Audiorast.Button.Filled">
        <item name="android:background">@drawable/button_filled</item>
        <item name="android:textColor">@color/vinyl</item>
    </style>

    <style name="Audiorast.Button.Outlined">
        <item name="android:background">@drawable/button_outlined</item>
        <item name="android:textColor">@color/cream</item>
    </style>
</resources>
